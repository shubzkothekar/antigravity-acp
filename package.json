{
  "name": "antigravity-acp",
  "description": "An Agent Client Protocol (ACP) server for Google Antigravity's `agy` CLI. Runs on Node via tsx (npx) or Bun. Connects ACP-compatible editors to drive `agy` with live streaming and history replay.",
"version": "1.3.0",
  "module": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agy-acp": "bin/agy-acp.mjs",
    "antigravity-acp": "bin/agy-acp.mjs"
  },
  "files": [
    "bin",
    "index.ts",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "tsx index.ts",
    "start:bun": "bun run index.ts",
    "postinstall": "tsx scripts/postinstall.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "build:mac-arm64": "bun build --compile --target=bun-darwin-arm64   index.ts --outfile dist/agy-acp-darwin-arm64",
    "build:mac-x64": "bun build --compile --target=bun-darwin-x64     index.ts --outfile dist/agy-acp-darwin-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64    index.ts --outfile dist/agy-acp-linux-arm64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64      index.ts --outfile dist/agy-acp-linux-x64",
    "build:win-arm64": "bun build --compile --target=bun-windows-arm64 index.ts --outfile dist/agy-acp-windows-arm64.exe",
    "build:win-x64": "bun build --compile --target=bun-windows-x64    index.ts --outfile dist/agy-acp-windows-x64.exe",
    "build:all": "bun run build:mac-arm64 && bun run build:mac-x64 && bun run build:linux-arm64 && bun run build:linux-x64 && bun run build:win-arm64 && bun run build:win-x64"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.0.0",
    "@bufbuild/protobuf": "^2.12.1",
    "better-sqlite3": "^13.0.2",
    "tsx": "^4.23.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubzkothekar/antigravity-acp.git"
  },
  "bugs": {
    "url": "https://github.com/shubzkothekar/antigravity-acp/issues"
  },
  "homepage": "https://github.com/shubzkothekar/antigravity-acp#readme",
  "license": "MIT"
}
